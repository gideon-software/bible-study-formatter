# ==============================================================================
# Bible Study Formatter - Environment Variables Configuration
# ==============================================================================

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Required scopes: https://www.googleapis.com/auth/documents and https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Crossway ESV API (Sign up for free at https://api.esv.org/)
ESV_API_KEY=your_crossway_esv_api_key_here

# American Bible Society API.Bible (Sign up for free at https://api.bible/)
# Used for CSB, NIV, and NASB translations
API_BIBLE_KEY=your_api_bible_key_here
# Optional custom Bible IDs (defaults are preconfigured in code):
# API_BIBLE_CSB_ID=a556c5305ee15c3f-01
# API_BIBLE_NIV_ID=78a9f6124f344018-01
# API_BIBLE_NASB_ID=a761ca71e0b3ddcf-01

# NET Bible: Powered by the public labs.bible.org API (no API key required)

# Neon Serverless Postgres (Sign up for free at https://neon.tech)
# Pooled connection string from your Neon project dashboard
DATABASE_URL=postgresql://user:password@ep-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Admin Access Whitelist
# Comma-separated list of Google email addresses allowed to view /admin
ADMIN_EMAILS=gideonsoftwaresolutions@gmail.com

# Alert Notifications (Instant alert when parsing failures or missing elements occur)
# Option A: Discord / Slack Webhook URL
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_token
# Option B: Resend Transactional Email (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
ALERT_EMAIL_TO=gideonsoftwaresolutions@gmail.com

# Canary Health Check Cron Secret (Optional header authorization)
CRON_SECRET=random_canary_secret_token_123
